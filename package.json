{
  "name": "choros",
  "version": "0.28.0",
  "private": true,
  "type": "module",
  "module": "src/main.ts",
  "imports": {
    "#choros/*": "./src/*"
  },
  "bin": {
    "choros": "src/main.ts"
  },
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun test",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "latest",
    "simple-git-hooks": "^2.13.1"
  },
  "peerDependencies": {
    "typescript": "6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run check"
  }
}
