{
  "name": "choros",
  "version": "1.0.0",
  "description": "Inter-session messaging and swarm coordination for Claude Code sessions. One long-lived daemon + per-CC MCP shims; SQLite-backed state; JSON-RPC over Unix sockets.",
  "license": "MIT",
  "author": "Cory Gabrielsen",
  "private": true,
  "type": "module",
  "module": "src/shim/main.ts",
  "imports": {
    "#choros/*": "./src/*"
  },
  "bin": {
    "choros": "src/shim/main.ts",
    "choros-daemon": "src/daemon/main.ts",
    "choros-gh-bridge": "src/bridges/github/main.ts",
    "choros-doctor": "src/selftest.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:cov": "bun test --coverage",
    "daemon": "bun run src/daemon/main.ts",
    "gh-bridge": "bun run src/bridges/github/main.ts",
    "doctor": "bun run src/selftest.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun test",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "latest",
    "simple-git-hooks": "^2.13.1"
  },
  "peerDependencies": {
    "typescript": "6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run check"
  }
}
