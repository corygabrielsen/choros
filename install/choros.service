# choros daemon — systemd USER unit
#
# Install (per-user, no root needed):
#   mkdir -p ~/.config/systemd/user
#   ln -sf $(realpath ~/code/choros/install/choros.service) ~/.config/systemd/user/choros.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now choros
#
# Status / logs:
#   systemctl --user status choros
#   journalctl --user -u choros -f

[Unit]
Description=choros daemon — inter-session messaging for Claude Code
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/env bun run %h/code/choros/src/daemon/main.ts
Restart=on-failure
RestartSec=5

# The daemon writes its state under ~/.local/state/choros (or
# $CHOROS_STATE_HOME if set). systemd --user runs with a stripped PATH
# that lacks bun's dir — install.sh writes a PATH drop-in
# (choros.service.d/override.conf) so `env bun` resolves; without it the
# unit exits 127.
Environment=NODE_ENV=production

# Choros runs as a foreground process; let systemd own stdout/stderr.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
