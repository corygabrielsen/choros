<?xml version="1.0" encoding="UTF-8"?>
<!--
  choros daemon — launchd LaunchAgent

  Install (per-user, no sudo needed):
    mkdir -p ~/Library/LaunchAgents
    ln -sf $(realpath ~/code/choros/install/com.choros.daemon.plist) \
           ~/Library/LaunchAgents/com.choros.daemon.plist
    launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.choros.daemon.plist

  Status / logs:
    launchctl print gui/$UID/com.choros.daemon
    tail -f ~/Library/Logs/choros/daemon.{out,err}.log

  Replace HOME_PLACEHOLDER below with your home dir before the first
  bootstrap (launchd plists don't expand $HOME). The install script
  below the install line above should do the substitution.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTD/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.choros.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>bun</string>
        <string>run</string>
        <string>HOME_PLACEHOLDER/code/choros/src/daemon/main.ts</string>
    </array>

    <!--
      launchd does not inherit the login shell's PATH, so a bare `bun`
      won't resolve. install.sh substitutes BUN_DIR_PLACEHOLDER with
      bun's actual directory at install time.
    -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>BUN_DIR_PLACEHOLDER:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!--
      KeepAlive dict-form so the daemon's own clean-exit code paths
      (uninstall, manual `launchctl unload`) stay down, while genuine
      crashes (segfault, SIGKILL) respawn. Using plain <true/> here
      causes launchd to fight our hard-exit codes (e.g. exit(130) on
      second SIGINT, exit(1) on stale-lock collision) and respawn
      into a guaranteed-immediate-failure loop.
    -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>HOME_PLACEHOLDER/Library/Logs/choros/daemon.out.log</string>

    <key>StandardErrorPath</key>
    <string>HOME_PLACEHOLDER/Library/Logs/choros/daemon.err.log</string>
</dict>
</plist>
